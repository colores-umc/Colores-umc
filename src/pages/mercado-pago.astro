---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Mercado Pago - Colores">
  <PageHero title="Pagar con Mercado Pago" subtitle="Escaneá y abonás en segundos" />

  <section class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center max-w-5xl mx-auto">
      <div class="reveal">
        <h2 class="text-3xl font-bold italic mb-4">Escaneá y pagá</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Para realizar un pago por Mercado Pago necesitás otro dispositivo con la aplicación
          <strong>Mercado Pago</strong> y escanear el código QR.
        </p>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 text-mint-deep flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            <span>
              Tutorial:
              <a href="https://www.youtube.com/watch?v=S1amQ5T29tE" target="_blank" rel="noopener" class="text-mint-deep underline hover:text-dark">
                Cómo escanear QR en Mercado Pago
              </a>
            </span>
          </li>
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 text-mint-deep flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            <span>
              Bajar la app:
              <a
                href="https://play.google.com/store/apps/details?id=com.mercadopago.wallet&hl=es_AR"
                target="_blank"
                rel="noopener"
                class="text-mint-deep underline hover:text-dark"
              >
                Google Play
              </a>
            </span>
          </li>
        </ul>
      </div>

      <div class="reveal">
        <div class="bg-white rounded-2xl shadow-2xl p-6 border border-gray-200">
          <img
            src={`${base}/assets/img/mercado-pago/mercado-pago.png`}
            alt="Código QR Mercado Pago de Colores"
            class="w-full h-auto rounded-lg"
          />
          <p class="text-center text-sm text-gray-500 mt-4 italic">
            Escaneá este código con la app de Mercado Pago
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
