      { src: img('acero/acero 2.jpg') },
      { src: img('acero/acero 3.jpg') },
      { src: img('acero/acero 4.jpg') },
      { src: img('acero/acero 5.jpeg') },
      { src: img('acero/WhatsApp Image 2020-08-02 at 19.39.30.jpeg') },
    ],
  },
  {
    title: 'Acrílicos',
    images: [
      { src: img('acrilico/acrilicos.jpg'), caption: 'Liso' },
      { src: img('acrilico/acrilicos 2.jpeg'), caption: 'Facetado' },
      { src: img('acrilico/Acrilico infantil.JPG'), caption: 'Infantil' },
    ],
    catalog: 'h30gmf3xu3',
  },
  {
    title: 'Cadenas',
    images: [
      { src: img('cadenas/cadenas.jpg'), caption: 'Níquel' },
      { src: img('cadenas/IMG-20190102-WA0022.jpg'), caption: 'Color' },
