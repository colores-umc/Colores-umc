---

<Layout title="Armador - Colores">
  <PageHero
    title="Armador"
    subtitle="Piezas versátiles para componer mil diseños"
    image={`${base}/assets/img/index/categorias/armado.jpg`}
  />
  {sections.map((section) => <CategorySection {...section} />)}
</Layout>
