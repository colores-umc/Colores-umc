  },
  {
    title: 'Cristal Facetado',
    images: [
      { src: img('cristal/cristal roca.jpg') },
      { src: img('cristal/cristal roca 2.jpg') },
      { src: img('cristal/cristal roca 3.jpeg') },
    ],
  },
  {
    title: 'Dijes',
    images: [
      { src: img('dijes/dijes 2.jpg') },
      { src: img('dijes/dije.JPG') },
