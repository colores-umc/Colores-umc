      { src: img('gemas/gemas 3.jpeg'), caption: 'Boreal' },
      { src: img('gemas/gemas 4.jpeg'), caption: 'Cristal con Base' },
    ],
  },
  {
    title: 'Piedras Naturales',
    images: [
      { src: img('piedras/piedras.jpg') },
      { src: img('piedras/piedras 1.jpeg') },
      { src: img('piedras/piedras 2.jpg') },
    ],
  },
  {
    title: 'Cueros',
    images: [
      { src: `${base}/assets/img/cueros/34584077_327984871066851_8485899325765844992_n.jpg` },
      { src: `${base}/assets/img/cueros/WhatsApp Image 2020-10-10 at 16.16.34.jpeg` },
