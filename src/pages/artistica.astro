---

<Layout title="Artística - Colores">
  <PageHero
    title="Artística"
    subtitle="Insumos para realizar tus mejores ideas"
    image={`${base}/assets/img/index/categorias/artistica.jpg`}
  />
  {sections.map((section) => <CategorySection {...section} />)}
</Layout>
