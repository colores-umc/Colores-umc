      { src: img('sombreros/gorros.jpg') },
      { src: img('sombreros/gorros 2.jpg') },
      { src: img('sombreros/gorros 3.jpg') },
      { src: img('sombreros/gorros 4.jpg') },
      { src: img('sombreros/sombrerosss.jpg') },
