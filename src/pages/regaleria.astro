---

<Layout title="Regalería - Colores">
  <PageHero
    title="Regalería"
    subtitle="Detalles para conectar con otros, genuinos y auténticos"
    image={`${base}/assets/img/index/categorias/regaleria.jpeg`}
  />
  {sections.map((section) => <CategorySection {...section} />)}
</Layout>
