---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Página no encontrada - Colores">
  <section class="min-h-[80vh] flex items-center justify-center bg-gradient-to-br from-mint-soft to-mint">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <p class="font-script text-7xl text-dark mb-4">colores</p>
      <h1 class="text-6xl md:text-8xl font-bold text-dark mb-4">404</h1>
      <p class="text-xl text-dark/80 mb-8">
        La página momentáneamente se encuentra en reparación. Estamos trabajando en ello —
        recargá la página en 20 minutos.
      </p>

      <img
        src={`${base}/robotito.jpg`}
        alt="Robotito"
        class="mx-auto w-48 h-48 object-contain mb-8 animate-pulse-soft"
      />

      <a
        href={`${base}/`}
        class="inline-block bg-dark text-mint px-8 py-3 rounded-full uppercase tracking-wider font-medium hover:bg-dark/80 hover:scale-105 transition-all shadow-lg"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
