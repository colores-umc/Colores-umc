---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rubros = [
  {
    href: `${base}/artistica`,
    label: 'Artística',
    description: 'Insumos para realizar tus mejores ideas',
    image: `${base}/assets/img/index/categorias/artistica.jpg`,
  },
  {
    href: `${base}/armado`,
    label: 'Armador',
    description: 'Piezas versátiles para componer mil diseños',
    image: `${base}/assets/img/index/categorias/armado.jpg`,
  },
  {
    href: `${base}/laneria`,
    label: 'Lanería',
    description: 'Todo para desarrollar tus tejidos',
    image: `${base}/assets/img/index/categorias/tejidos.jpg`,
  },
  {
    href: `${base}/merceria`,
    label: 'Mercería',
    description: 'Materiales para tus proyectos de moda y costura',
    image: `${base}/assets/img/index/categorias/merceria3.jpeg`,
  },
  {
    href: `${base}/regaleria`,
    label: 'Regalería',
    description: 'Detalles para conectar con otros, genuinos y auténticos',
    image: `${base}/assets/img/index/categorias/regaleria.jpeg`,
  },
  {
    href: `${base}/talleres`,
    label: 'Talleres Creativos',
    description: 'Explorá tu creatividad en nuestros talleres artísticos',
    image: `${base}/assets/img/index/categorias/talleres2.jpg`,
  },
];

const services = [
  {
    title: 'Asesoramiento',
    description: 'Asesorate con nuestra diseñadora',
    icon: 'chat',
  },
  {
    title: 'Venta Online',
    description: 'Contactanos por nuestras redes o teléfonos para realizar tus pedidos',
    icon: 'cart',
  },
  {
    title: 'Delivery',
    description: 'Elegí tu modo de envío o retiro',
    icon: 'delivery',
  },
];

const historia = [
  {
    year: '2015 - 2016',
    title: 'Los Inicios',
    text: 'Colores nace como una empresa familiar en diciembre de 2015 con la finalidad de brindar opciones creativas con un modelo de atención novedoso en la ciudad de Concordia.',
    image: `${base}/assets/img/index/historia/inaguracion.jpg`,
  },
  {
    year: 'Marzo 2018',
    title: 'Colores se reubica',
    text: 'Nos trasladamos al actual local, ampliando significativamente nuestra capacidad, brindando una mayor variedad y comodidad a nuestros clientes.',
    image: `${base}/assets/img/index/historia/reubica.jpg`,
  },
  {
    year: 'Diciembre 2019',
    title: 'Nace SieteColores',
    text: 'Nuestra propia marca de accesorios de moda. Nace a raíz del pedido de clientes que buscaban un producto final diseñado para ocasiones especiales.',
    image: `${base}/assets/img/index/historia/sietecolores.jpg`,
  },
  {
    year: 'Agosto 2021',
    title: 'Colores en Santa Fe',
    text: 'Continuando con la intención de brindar una mejor atención abrimos una nueva sucursal, diversificándonos y ampliando la zona de envíos, pero con el mismo estilo y servicio que nos caracteriza.',
    image: `${base}/assets/img/index/historia/santafe.jpeg`,
  },
  {
    year: 'Marzo 2023',
    title: 'Talleres Creativos',
    text: 'Inauguramos en nuestra sucursal de Santa Fe un nuevo espacio destinado al dictado de encuentros formativos, concebido para acompañar el aprendizaje y la práctica de quienes nos eligen.',
    image: `${base}/assets/img/index/historia/talleres.jpg`,
  },
];

const team = [
  {
    name: 'Sandra Packosky',
    role: 'Directora Ejecutiva',
    image: `${base}/assets/img/index/sandra.jpeg`,
  },
  {
    name: 'Daniel François',
    role: 'Director de Finanzas',
    image: `${base}/assets/img/index/daniel.jpg`,
  },
];

const marcas = [
  { src: `${base}/assets/img/index/marcas/saphirus.svg`, alt: 'Saphirus' },
  { src: `${base}/assets/img/index/marcas/EQ.png`, alt: 'EQ' },
  { src: `${base}/assets/img/index/marcas/suprabond.jpg`, alt: 'Suprabond' },
  { src: `${base}/assets/img/index/marcas/cintas.png`, alt: 'Cintas' },
];
---

<Layout title="Colores - Un Mundo Creativo">
  <!-- Hero -->
  <section
    id="page-top"
    class="relative min-h-screen flex items-center justify-center -mt-16 pt-16 overflow-hidden bg-cover bg-center"
    style={`background-image: url('${base}/assets/img/index/dandeleon.jpg')`}
  >
    <div class="container mx-auto px-4 text-center relative z-10">
      <p class="text-dark/80 uppercase tracking-[0.3em] text-sm mb-4 reveal drop-shadow-sm">Bienvenidos a</p>
      <h1 class="font-script text-7xl md:text-9xl text-dark mb-4 reveal drop-shadow-md">colores</h1>
      <p class="text-2xl md:text-3xl text-dark/90 mb-10 reveal drop-shadow-sm">Un Mundo Creativo</p>
      <a
        href="#portfolio"
        class="inline-block bg-dark text-mint px-10 py-4 rounded-full uppercase tracking-wider font-medium hover:bg-dark/80 hover:scale-105 transition-all shadow-2xl reveal"
      >
        Entrar
      </a>
    </div>
  </section>

  <!-- Rubros -->
  <section id="portfolio" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl uppercase font-bold mb-3 reveal">Rubros</h2>
        <p class="text-gray-500 text-lg reveal">Descubrí las opciones que tenemos en nuestro negocio</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {rubros.map((rubro) => (
          <a
            href={rubro.href}
            class="group relative block rounded-2xl overflow-hidden aspect-[4/3] shadow-md hover:shadow-2xl transition-all duration-500 reveal"
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
              style={`background-image: url('${rubro.image}')`}
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/40 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-end p-6 text-white">
              <h3 class="text-2xl font-bold mb-1">{rubro.label}</h3>
              <p class="text-sm text-white/85 transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                {rubro.description}
              </p>
            </div>
            <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-mint flex items-center justify-center text-dark opacity-0 group-hover:opacity-100 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section id="services" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl uppercase font-bold reveal">Servicios</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="text-center reveal">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-mint text-dark mb-4">
              {service.icon === 'chat' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              )}
              {service.icon === 'cart' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {service.icon === 'delivery' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold uppercase mb-2">{service.title}</h3>
            <p class="text-gray-600 max-w-sm mx-auto">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section id="about" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl uppercase font-bold mb-3 reveal">Nuestra Historia</h2>
        <p class="text-gray-500 text-lg reveal">Cómo surgimos y hacia dónde vamos</p>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <!-- Línea vertical: a la izquierda en mobile, centrada en desktop -->
        <div class="absolute left-20 md:left-1/2 top-0 bottom-0 w-1 bg-mint/40 md:-translate-x-1/2"></div>

        {historia.map((item, idx) => (
          <div class={`relative grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-16 reveal ${idx % 2 === 1 ? 'md:[&>:first-child]:order-2' : ''}`}>
            <!-- Imagen circular grande -->
            <div class={`flex justify-center md:justify-${idx % 2 === 0 ? 'end' : 'start'} pl-32 md:pl-0`}>
              <div class="relative">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="w-48 h-48 md:w-56 md:h-56 rounded-full object-cover border-8 border-white shadow-xl ring-4 ring-mint/40"
                />
              </div>
            </div>

            <!-- Texto -->
            <div class={`pl-32 md:pl-0 ${idx % 2 === 0 ? 'md:pl-8 md:text-left' : 'md:pr-8 md:text-right'}`}>
              <p class="text-mint-deep font-bold text-sm uppercase tracking-wider mb-1">{item.year}</p>
              <h3 class="text-2xl md:text-3xl font-bold mb-2">{item.title}</h3>
              <p class="text-gray-600 leading-relaxed">{item.text}</p>
            </div>

            <!-- Punto en la línea (solo desktop) -->
            <div class="hidden md:block absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-mint border-4 border-white shadow-md"></div>
            <!-- Punto en la línea (mobile, alineado con la línea de la izquierda) -->
            <div class="md:hidden absolute left-20 top-24 -translate-x-1/2 w-5 h-5 rounded-full bg-mint border-4 border-white shadow-md"></div>
          </div>
        ))}

        <div class="relative flex justify-center reveal pl-32 md:pl-0">
          <div class="bg-mint text-dark px-8 py-6 rounded-2xl shadow-lg max-w-md text-center">
            <h3 class="text-xl font-bold">¡Sé parte de nuestra historia!</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {team.map((person) => (
          <div class="text-center reveal">
            <img
              src={person.image}
              alt={person.name}
              class="w-40 h-40 rounded-full object-cover mx-auto mb-4 shadow-lg ring-4 ring-mint/30"
            />
            <h3 class="text-xl font-bold">{person.name}</h3>
            <p class="text-gray-500 uppercase tracking-wide text-sm">{person.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Marcas -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center">
        {marcas.map((marca) => (
          <div class="flex items-center justify-center reveal">
            <img
              src={marca.src}
              alt={marca.alt}
              class="max-h-20 w-auto opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section
    id="contact"
    class="py-20 bg-cover bg-center relative"
    style={`background-image: linear-gradient(rgba(33,37,41,0.85), rgba(33,37,41,0.85)), url('${base}/assets/img/index/map-image.png')`}
  >
    <div class="container mx-auto px-4 text-white">
      <div class="text-center mb-10">
        <h2 class="text-4xl md:text-5xl uppercase font-bold mb-4 reveal">Contacto</h2>
        <p class="text-white/80 text-lg reveal">Escribinos por WhatsApp y te respondemos a la brevedad</p>
      </div>

      <div class="max-w-2xl mx-auto bg-white/10 backdrop-blur-sm rounded-2xl p-8 reveal">
        <p class="text-center text-xl mb-6">
          <strong>Santa Fe:</strong> 0342 155 007976
        </p>
        <a
          href="https://wa.me/5493425007976"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-3 w-full bg-mint text-dark px-8 py-4 rounded-full uppercase tracking-wider font-medium hover:bg-mint-soft hover:scale-[1.02] transition-all shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
          </svg>
          Enviar mensaje por WhatsApp
        </a>
        <p class="text-center text-white/60 text-sm mt-6">
          También nos escribís a
          <a href="mailto:coloresumc@gmail.com" class="text-mint hover:underline">coloresumc@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
