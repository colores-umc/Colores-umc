---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fotos = [
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.15.59 (copia).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.00 (1).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.00 (2).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.00 (3) (copia).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.01 (2).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.01 (3).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.02.jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.04.jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.16.04 (1).jpeg`,
  `${base}/assets/img/ubicacion/santa fe/WhatsApp Image 2021-08-23 at 14.17.20 (1).jpeg`,
];
---

<Layout title="Ubicación - Colores">
  <PageHero title="Dónde encontrarnos" subtitle="Av. Aristóbulo del Valle 6655 - Santa Fe" />

  <section class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <div class="rounded-2xl overflow-hidden shadow-lg reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7411.026940232386!2d-60.697001119029!3d-31.607258940887668!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b5075eb86c8f11%3A0x57efbc9d18ad6c4f!2sAv.%20Arist%C3%B3bulo%20del%20Valle%206655%2C%20Santa%20Fe!5e0!3m2!1ses-419!2sar!4v1627345449574!5m2!1ses-419!2sar"
          width="100%"
          height="100%"
          style="min-height: 400px;"
          loading="lazy"
          allowfullscreen
          frameborder="0"
          title="Mapa Colores Santa Fe"
        ></iframe>
      </div>

      <div class="grid grid-cols-2 gap-3 reveal">
        {fotos.slice(0, 4).map((foto) => (
          <button
            type="button"
            class="lightbox-trigger group block overflow-hidden rounded-xl shadow-sm hover:shadow-xl transition-shadow"
            data-img={foto}
            aria-label="Ampliar foto"
          >
            <img
              src={foto}
              alt="Local Colores Santa Fe"
              loading="lazy"
              class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </button>
        ))}
      </div>
    </div>

    <div class="mt-12 text-center reveal">
      <a
        href="https://maps.google.com/?q=Av.+Aristóbulo+del+Valle+6655,+Santa+Fe"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-mint text-dark px-6 py-3 rounded-full uppercase tracking-wider font-medium hover:bg-mint-soft hover:scale-105 transition-all shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Abrir en Google Maps
      </a>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 reveal">Más fotos del local</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 max-w-6xl mx-auto">
        {fotos.slice(4).map((foto) => (
          <button
            type="button"
            class="lightbox-trigger group block overflow-hidden rounded-xl shadow-sm hover:shadow-lg transition-shadow reveal"
            data-img={foto}
            aria-label="Ampliar foto"
          >
            <img
              src={foto}
              alt="Local Colores Santa Fe"
              loading="lazy"
              class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </button>
        ))}
      </div>
    </div>
  </section>
</Layout>
