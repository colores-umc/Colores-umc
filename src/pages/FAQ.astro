---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqs = [
  {
    q: '¿Dónde se encuentra el local?',
    a: 'Podés encontrarnos en Santa Fe en Av. Aristóbulo del Valle 6655. Para más info entrá en <a href="' + base + '/ubicacion" class="text-mint-deep underline hover:text-dark">ubicación</a>.',
  },
  {
    q: '¿Se puede pagar con tarjeta de crédito/débito?',
    a: 'Sí, se puede abonar tanto desde el local como desde la Web vía Mercado Pago. Para más info entrá en <a href="' + base + '/mercado-pago" class="text-mint-deep underline hover:text-dark">Mercado Pago</a>.',
  },
  {
    q: '¿La mercadería se vende por peso, empaquetada o de qué forma?',
    a: 'En función del rubro, se vende fraccionada, por peso o en forma individual.',
  },
  {
    q: '¿Realizan ventas al por mayor?',
    a: 'El comercio es principalmente minorista, pero en compras de paquetes cerrados realizamos descuentos.',
  },
  {
    q: 'Contactos para pedidos online',
    a: `WhatsApp: <a href="https://wa.me/5493425007976" class="text-mint-deep underline hover:text-dark">0342 155 007976</a><br>
        Instagram Colores: <a href="https://www.instagram.com/colores_un_mundo_creativo/" class="text-mint-deep underline hover:text-dark" target="_blank" rel="noopener">@colores_un_mundo_creativo</a><br>
        Instagram Sietecolores: <a href="https://www.instagram.com/sietecoloresoficial/" class="text-mint-deep underline hover:text-dark" target="_blank" rel="noopener">@sietecoloresoficial</a><br>
        Facebook: <a href="https://www.facebook.com/coloresunmundocreativo" class="text-mint-deep underline hover:text-dark" target="_blank" rel="noopener">Colores Un Mundo Creativo</a>`,
  },
];
---

<Layout title="Preguntas Frecuentes - Colores">
  <PageHero title="Preguntas Frecuentes" subtitle="Lo que más nos preguntan" />

  <div class="container mx-auto px-4 py-16 max-w-3xl">
    <div class="space-y-6">
      {faqs.map((faq, idx) => (
        <details class="group bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden reveal" open={idx === 0}>
          <summary class="cursor-pointer list-none px-6 py-5 flex items-start gap-4 hover:bg-gray-50 transition-colors">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-mint text-dark font-bold flex items-center justify-center">
              {idx + 1}
            </span>
            <h2 class="flex-1 text-lg font-bold text-dark pt-1">{faq.q}</h2>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 mt-2 text-mint-deep transition-transform group-open:rotate-180 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-5 pl-18 text-gray-700 leading-relaxed" set:html={faq.a}></div>
        </details>
      ))}
    </div>

    <div class="mt-16 text-center bg-mint/20 rounded-2xl p-8 reveal">
      <h2 class="text-2xl font-bold mb-3">¿Tu consulta no está acá?</h2>
      <p class="text-gray-700 mb-6">Escribinos por WhatsApp y te respondemos a la brevedad</p>
      <a
        href="https://wa.me/5493425007976"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-3 bg-mint text-dark px-8 py-4 rounded-full uppercase tracking-wider font-medium hover:bg-mint-soft hover:scale-105 transition-all shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
        </svg>
        WhatsApp 0342 155 007976
      </a>
    </div>
  </div>
</Layout>
