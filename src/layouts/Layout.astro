---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Colores - Un Mundo Creativo',
  description = 'Colores: tu tienda de armado, mercería, lanería, regalería, artística y talleres en Concordia y Santa Fe.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Montserrat:wght@400;500;700&display=swap"
    />

    <!-- Google Analytics -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=UA-174184615-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'UA-174184615-1');
    </script>
  </head>
  <body class="bg-white text-dark antialiased">
    <Header />
    <div class="cinta-mayo" aria-hidden="true">
      <span class="cinta-mayo-sol">☀</span>
      <span class="cinta-mayo-texto">Semana de Mayo</span>
      <span class="cinta-mayo-sol">☀</span>
    </div>
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
    <Lightbox />

    <style>
      .cinta-mayo {
        position: fixed;
        top: 42px;
        right: -82px;
        width: 320px;
        transform: rotate(45deg);
        background: linear-gradient(
          to bottom,
          #74acdf 0,
          #74acdf 28%,
          #ffffff 28%,
          #ffffff 72%,
          #74acdf 72%,
          #74acdf 100%
        );
        color: #1a3a6c;
        text-align: center;
        padding: 14px 0;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
        z-index: 100;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        pointer-events: none;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: 'Montserrat', sans-serif;
      }
      .cinta-mayo-sol {
        color: #f4b400;
        font-size: 1.25rem;
        text-shadow: 0 0 2px #c08400;
      }
      @media (max-width: 640px) {
        .cinta-mayo {
          top: 30px;
          right: -90px;
          width: 260px;
          padding: 10px 0;
          font-size: 0.7rem;
          letter-spacing: 1px;
        }
        .cinta-mayo-sol {
          font-size: 1rem;
        }
      }
    </style>

    <script>
      // Animaciones reveal-on-scroll usando IntersectionObserver
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
