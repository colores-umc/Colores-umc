---
interface ImageItem {
  src: string;
  caption?: string;
  alt?: string;
}

interface Props {
  images: ImageItem[];
  /** Cantidad de columnas en desktop. Default 3. */
  columns?: 2 | 3 | 4;
}

const { images, columns = 3 } = Astro.props;

const gridClass =
  columns === 2
    ? 'grid grid-cols-1 sm:grid-cols-2 gap-6'
    : columns === 4
    ? 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5'
    : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6';
---

<div class={gridClass}>
  {images.map((image) => (
    <figure class="reveal">
      <button
        type="button"
        class="lightbox-trigger group block w-full overflow-hidden rounded-2xl border border-gray-200 shadow-sm hover:shadow-xl transition-all"
        data-img={image.src}
        aria-label={`Ampliar ${image.alt ?? image.caption ?? 'imagen'}`}
      >
        <img
          src={image.src}
          alt={image.alt ?? image.caption ?? ''}
          loading="lazy"
          class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </button>
      {image.caption && (
        <figcaption class="mt-3 text-center italic text-gray-700">{image.caption}</figcaption>
      )}
    </figure>
  ))}
</div>
