---
interface Props {
  /** Hash del catálogo en flipsnack (ej: "h30gmf3xu3") */
  hash: string;
  label?: string;
}

const { hash, label = 'Catálogo' } = Astro.props;
---

<div class="my-10 reveal">
  <h3 class="text-lg italic text-gray-700 mb-3">{label}:</h3>
  <div class="rounded-xl overflow-hidden shadow-md bg-white">
    <iframe
      src={`https://cdn.flipsnack.com/widget/v2/widget.html?hash=${hash}`}
      width="100%"
      height="480"
      loading="lazy"
      title={label}
      frameborder="0"
      allowfullscreen
    ></iframe>
  </div>
</div>
