---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${base}/#portfolio`, label: 'Rubros' },
  { href: `${base}/#services`, label: 'Servicios' },
  { href: `${base}/#about`, label: 'Historia' },
  { href: `${base}/#contact`, label: 'Contacto' },
  { href: `${base}/ubicacion`, label: 'Ubicación' },
  { href: `${base}/mercado-pago`, label: 'Mercado Pago' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-dark/95 backdrop-blur-md shadow-md">
  <nav class="container mx-auto flex items-center justify-between px-4 py-3 lg:px-8">
    <a href={`${base}/`} class="font-script text-3xl text-mint hover:text-mint-soft transition-colors">
      colores
    </a>

    <button
      id="nav-toggle"
      class="lg:hidden flex items-center justify-center w-10 h-10 rounded bg-mint text-dark"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <ul
      id="nav-menu"
      class="hidden lg:flex absolute lg:static top-full left-0 right-0 lg:top-auto flex-col lg:flex-row items-stretch lg:items-center gap-0 lg:gap-6 bg-dark lg:bg-transparent shadow-lg lg:shadow-none uppercase text-sm tracking-wide"
    >
      {navItems.map(item => (
        <li class="border-t border-white/10 lg:border-0">
          <a
            href={item.href}
            class="block px-4 py-3 text-white hover:text-mint transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Cerrar el menú móvil cuando hacen click en un link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) {
        menu.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
