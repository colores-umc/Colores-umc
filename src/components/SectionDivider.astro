---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center justify-center my-12 reveal">
  <span class="block w-12 md:w-20 h-px bg-mint-deep"></span>
  <h2 class="px-6 text-2xl md:text-3xl font-bold uppercase tracking-wide text-dark">
    {title}
  </h2>
  <span class="block w-12 md:w-20 h-px bg-mint-deep"></span>
</div>
